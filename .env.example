# Copy to .env and fill in. .env is git-ignored.

# Canvas: Account > Settings > New Access Token
CANVAS_URL=https://your-school.instructure.com
CANVAS_TOKEN=
CANVAS_COURSE_ID=

# Google Sheets: the ID is the long string in the sheet's URL.
# Share the sheet with the service account's email so it can write rows.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Optional: a Hugging Face model ID or local path (defaults to connork0/10Batch25Epoch2Grad)
# TEKS_MODEL=models/teks-distilbert
